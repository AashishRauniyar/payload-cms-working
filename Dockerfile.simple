# Coolify Deployment Dockerfile
# Simplified and optimized for Coolify with better error handling

FROM node:22.12.0-alpine AS base

# Install system dependencies
RUN apk add --no-cache libc6-compat
RUN corepack enable pnpm

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Set environment variables
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build the application (without database)
RUN pnpm build:compile

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Set up directories and permissions
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Copy built application
RUN cp -r .next/standalone/* . || echo "No standalone build found"
RUN cp -r .next/static ./.next/static || echo "No static files found"

# Make startup script executable
RUN chmod +x start-coolify.sh

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3019
ENV PORT=3019
ENV HOSTNAME="0.0.0.0"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3019/api/health || exit 1

# Start the application
CMD ["./start-coolify.sh"]
