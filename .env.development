# Development Environment Variables
# Copy this to .env.local for local development

# Database connection string for local development
DATABASE_URI=postgresql://payload:password123@localhost:5432/payload

# Generate a secure secret key - must be at least 32 characters
PAYLOAD_SECRET=development-secret-key-32-chars-minimum-change-for-prod

# Development server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3019

# Site information
NEXT_PUBLIC_SITE_NAME=Healthy Lifestyle Tips
NEXT_PUBLIC_SITE_DESCRIPTION=Your trusted source for evidence-based health and wellness information

# Secret used to authenticate cron jobs
CRON_SECRET=development-cron-secret-change-for-production

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Node environment
NODE_ENV=development
