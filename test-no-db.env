# Environment for testing without database
NODE_ENV=production
PORT=3019
HOSTNAME=0.0.0.0

# Mock database URI (won't be used due to SKIP_MIGRATIONS)
DATABASE_URI=postgresql://localhost:5432/mock

# Payload Configuration
PAYLOAD_SECRET=your-very-secure-payload-secret-key-here-minimum-32-characters-for-testing
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3019

# Next.js Configuration  
NEXT_PUBLIC_SERVER_URL=http://localhost:3019
NEXT_TELEMETRY_DISABLED=1

# Skip database operations for testing
SKIP_MIGRATIONS=true
SKIP_DB_WAIT=true
PAYLOAD_DISABLE_EMAIL=true