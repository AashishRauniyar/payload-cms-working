# Production Environment Variables for Docker
# Database connection string (using Docker service name)
DATABASE_URI=postgresql://payload:password123@postgres:5432/payload

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=https://healthylifestyletips.online

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE_CHANGE_FOR_PRODUCTION

# Used to validate preview requests
PREVIEW_SECRET=your-preview-secret-here-change-me-for-production

# Payload secret key - keep this secure (32+ characters)
PAYLOAD_SECRET=3b16281ff66f18458d65c322abc123def456ghi789jkl012mno345

# Site information
NEXT_PUBLIC_SITE_NAME=Healthy Lifestyle Tips
NEXT_PUBLIC_SITE_DESCRIPTION=Your trusted source for evidence-based health and wellness information

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Node environment
NODE_ENV=production

# Build Configuration
SKIP_MIGRATIONS=false
PAYLOAD_DISABLE_SHARP=false
PAYLOAD_DISABLE_EMAIL=true

# Port configuration
PORT=3000
HOSTNAME=0.0.0.0