# Production Environment Variables
# DO NOT commit this file to version control

# Database connection string - Replace with your production database
DATABASE_URI=postgresql://your-user:your-password@your-host:5432/your-database

# Generate a secure secret key - must be at least 32 characters
PAYLOAD_SECRET=change-this-to-a-32-character-secret-key

# Production server URL - Replace with your actual domain
NEXT_PUBLIC_SERVER_URL=http://healthylifestyletips.com

# Site information
NEXT_PUBLIC_SITE_NAME=Healthy Lifestyle Tips
NEXT_PUBLIC_SITE_DESCRIPTION=Your trusted source for evidence-based health and wellness information

# Secret used to authenticate cron jobs - Generate a secure secret
CRON_SECRET=change-this-to-a-secure-cron-secret

# Disable Next.js telemetry in production
NEXT_TELEMETRY_DISABLED=1

# Node environment
NODE_ENV=production
