# Node.js Options
NODE_OPTIONS="--no-deprecation --no-experimental-strip-types"

# Environment
NODE_ENV=production
PORT=3019
HOSTNAME=0.0.0.0

# Database Configuration (Test values - replace with real values for actual deployment)
DATABASE_URI=postgresql://test_user:test_password@localhost:5432/test_payload_db

# Payload Configuration
PAYLOAD_SECRET=your-very-secure-payload-secret-key-here-minimum-32-characters
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3019

# Next.js Configuration
NEXT_PUBLIC_SERVER_URL=http://localhost:3019
NEXT_TELEMETRY_DISABLED=1

# Optional: Skip migrations for quick testing
SKIP_MIGRATIONS=true

# Optional: Disable email for testing
PAYLOAD_DISABLE_EMAIL=true
