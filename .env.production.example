# PRODUCTION Environment Variables Template
# Copy this to .env.production and fill in real values

# ===== CRITICAL SECURITY SETTINGS =====
# Generate a secure 32+ character secret: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_32_CHARS_MINIMUM

# Database connection (use managed PostgreSQL service in production)
DATABASE_URI=postgresql://username:password@host:5432/database_name

# ===== SERVER CONFIGURATION =====
# Your actual production domain (NO trailing slash)
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=Your Site Name
NEXT_PUBLIC_SITE_DESCRIPTION=Your site description

# ===== SECURITY TOKENS =====
# Generate secure random strings for these
CRON_SECRET=CHANGE_THIS_TO_SECURE_CRON_SECRET
PREVIEW_SECRET=CHANGE_THIS_TO_SECURE_PREVIEW_SECRET

# ===== EMAIL CONFIGURATION (Production) =====
# Uncomment and configure for production email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=Your Site Name

# ===== STORAGE CONFIGURATION =====
# For production, consider cloud storage (AWS S3, Cloudinary, etc.)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# ===== MONITORING & ANALYTICS =====
# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===== PERFORMANCE =====
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# ===== BUILD FLAGS =====
SKIP_MIGRATIONS=false
PAYLOAD_DISABLE_EMAIL=false
PAYLOAD_DISABLE_SHARP=false